#!/usr/bin/env ruby

require_relative '../test/helpers'

include HD24::TestHelpers

output = open_midi_device(id: 9)

mmc = MIDI::MMC.new(output:)

mmc.reset

begin
  24.times.each do |track|
    mmc.write(nil)
    msg = mmc.write(track)
    pp(track => msg)
    gets
  end
ensure
  mmc.write(nil)
  mmc.reset
end