#!/usr/bin/env ruby

require 'hd24dig'

begin
  Simple::CommandParser.run(ARGV)
rescue Simple::CommandParser::UsageError => error
  STDERR.print <<~END
  Error: #{error}

  Usage: #{Path.new($0).basename} COMMAND ARGUMENTS...

  Commands:
    extract [--projects=PROJECTS] [--songs=SONGS] DRIVE [DIR]
      Extract tracks from DRIVE. If --projects or --songs is specified, only extract those
      projects or songs, respectively. Projects or sonsgs should be described by numbers
      separated by commas; for example, '--songs=1,5,10'. If DIR is specified, files will
      be saved to that directory. Otherwise, files will be saved in the current working
      directory.

    copy DRIVE IMAGE
      Copies DRIVE to a file at IMAGE. Only copies blocks that are actually in use.
      Creates a sparse image file, if filesystem supports that feature.

    info DRIVE
      Show information about DRIVE.
  END
  exit(1)
end